    "settings": {
        "terminal.integrated.env.windows": {
            "PLATFORMIO_CALLER": "vscode",
        },
        "files.exclude": {
            "**/cores/esp8266/core_version.h": true,
            "**/lib/KFCIOExpander/extra_include": true,
            "**/lib/KFCIOExpander/examples": true,
            "**/*.lst": true,
            "**/elf": true,
            "**/frameworks": true
        },
        // PlatformIO writes ~20k files into .pio (libdeps + build). Do not feed them
        // to the file watcher: extensions get no events for excluded paths, and the
        // build output changes on every compile/upload.
        // WITHOUT this, the STM32Cube Build Analyzer (`**/*.elf` watcher) re-parses
        // .pio/build/<env>/firmware.elf with st-arm-readobj --elf-output-style=JSON
        // after every build and blocks the extension host for ~40s (whole IDE freezes).
        "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/.pio/**": true,
            "**/node_modules/**": true,
            "**/logs/**": true,
            "**/elf/**": true,
            "**/frameworks/**": true,
            "**/data/webui/**": true,
            "**/data/.pvt/**": true,
            "**/scripts/audio_analyzer/.venv/**": true,
            "**/*.lst": true
        },
        "search.exclude": {
            "**/.git/**": true,
            "**/.pio/build/**": true,
            "**/node_modules/**": true,
            "**/logs/**": true,
            "**/elf/**": true,
            "**/data/webui/**": true
        },
        // keep .pio/libdeps in IntelliSense (LVGL/LovyanGFX/FastLED headers live there),
        // only drop the generated build tree
        "C_Cpp.files.exclude": {
            "**/.vscode": true,
