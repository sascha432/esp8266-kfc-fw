{
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "type": "shell",
                "command": "cmd",
                "args": [
                    "/c",
                    "pio",
                    "run",
                    "-t",
                    "rebuildfs",
                    ";",
                    "pio",
                    "run",
                    "-t",
                    "uploadfs",
                ],
                "problemMatcher": [
                    "$platformio"
                ],
                "label": "PlatformIO: Build and upload FS"
            }
        ]
    },
	"launch": {
		"configurations": [
            {
                "type": "gdb",
                "request": "launch",
                "name": "Launch Program",
                "target": "C:\\Users\\sascha\\Documents\\PlatformIO\\Projects\\kfc_fw\\.pio\\build\\clockv2\\firmware.elf",
                "autorun": [
                    "target remote \\\\.\\com4"
                ],
                "cwd": "${workspaceRoot}",
                "gdbpath": "C:\\Users\\sascha\\.platformio\\packages\\toolchain-xtensa@2.100200.0\\bin\\xtensa-lx106-elf-gdb.exe",
                "debugger_args": [ "--command=C:\\Users\\sascha\\Documents\\PlatformIO\\Projects\\kfc_fw\\scripts\\gdb.cmds" ],
                "valuesFormatting": "parseText"
            },
            {
                "name": "7 Segment Display",
                "type": "python",
                "request": "launch",
                "program": "${workspaceRoot}/scripts/tools/create_7segment_display.py",
                "args": ["fonts"],
                "console": "integratedTerminal"
            }
		],
		"compounds": []
	},
